results/pilot/*
!results/pilot/metrics.csv

# Signed topic formalization (contains signatures and personal data)
Topic-formalization*.docx
Topic-formalization*.pdf

# Presentations are kept locally
presentation/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Local tooling
.claude/
.DS_Store
